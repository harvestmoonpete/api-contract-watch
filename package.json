{
  "name": "api-contract-watch",
  "version": "0.1.0",
  "description": "An offline OpenAPI compatibility review tool with a CLI, GitHub Action, and browser report.",
  "type": "module",
  "private": true,
  "bin": {
    "contract-watch": "dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "dev": "vite --host 127.0.0.1 --port 5190",
    "build:cli": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "prettier": "3.6.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
