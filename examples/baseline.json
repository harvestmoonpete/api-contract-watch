{
  "openapi": "3.0.3",
  "info": {
    "title": "Parcel API",
    "version": "1.0.0"
  },
  "paths": {
    "/parcels": {
      "get": {
        "operationId": "listParcels",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["queued", "shipped", "delivered"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Parcel list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Parcel"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/parcels/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "delete": {
        "operationId": "deleteParcel",
        "responses": {
          "204": {
            "description": "Deleted"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Parcel": {
        "type": "object",
        "required": ["id", "status", "trackingUrl"],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["queued", "shipped", "delivered"]
          },
          "trackingUrl": {
            "type": "string"
          }
        }
      }
    }
  }
}
